# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Fluid Mist apps get the
# FLUID_* values injected automatically.

# ── Required: which Fluid company this storefront sells for ─────────────────
# Your company subdomain: "acme" for acme.fluid.app.
FLUID_SHOP=

# Alternatively, your Fluid storefront URL. Mist sets this one for you.
# FLUID_BASE_URL=https://acme.fluid.app

# ── Optional ────────────────────────────────────────────────────────────────
# Server-only company API token (PT-…; Mist injects it). Enables navigation
# from Fluid menus. Never prefix it with NEXT_PUBLIC_.
# FLUID_COMPANY_PRIVATE_TOKEN=

# Public URL of this storefront, for canonical URLs and the sitemap.
# Detected automatically on Vercel (including custom domains).
# NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Slugs of the Fluid menus used for the header and footer.
# FLUID_HEADER_MENU=main-menu
# FLUID_FOOTER_MENU=footer

# Seconds to cache Fluid data before refetching (default 300).
# FLUID_REVALIDATE_SECONDS=300

# Shared secret for POST /api/revalidate (on-demand cache refresh).
# REVALIDATE_SECRET=

# Override the Fairshare SDK bundle, e.g. to pin a version or test staging.
# FLUID_SDK_URL=https://assets.fluid.app/scripts/fluid-sdk/latest/web-widgets/index.js

# Fluid's public API origin. Only change this to test against another environment.
# FLUID_API_URL=https://api.fluid.app
